                    var est = ''; for (var i = 1; i <= 5; i++) est += i <= x.estrelas ? '★' : '☆';
                    var quem = '<b>' + esc(x.nomeExibicao || 'Cliente') + '</b>' + (x.usuarioMascarado ? ' · ' + esc(x.usuarioMascarado) : '') + ' · compró ' + esc(x.produto);
                    return '<article class="resena-card"><div class="est" aria-label="' + x.estrelas + ' de 5 estrellas">' + est + '</div>' + (x.texto ? '<p class="txt">“' + esc(x.texto) + '”</p>' : '') + '<div class="quem">' + quem + '</div></article>';
                  }).join('');
                  box.hidden = false;
                  var sec = document.getElementById('depoimentosCard'); if (sec) sec.style.display = 'flex';
