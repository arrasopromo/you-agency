          (function(){
            var b = document.getElementById('yaCtaPaquetes');
            if (b) b.addEventListener('click', function(e){
              var h = document.getElementById('yaHero'); if (!h) return;
              e.preventDefault();
              h.scrollIntoView({ behavior: 'smooth', block: 'start' });
              setTimeout(function(){ var i = document.getElementById('yaArrobaInput'); if (i) i.focus({ preventScroll: true }); }, 600);
            });
            var n = document.getElementById('yaCtaNum'); if (!n || !('IntersectionObserver' in window)) return;
            if (window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches) { n.textContent = '2,180'; return; }
            var io = new IntersectionObserver(function(es){
              if (!es[0].isIntersecting) return; io.disconnect();
              var t0 = null, de = 1180, ate = 2180;
              var f = function(t){ if (!t0) t0 = t; var k = Math.min(1, (t - t0) / 1600), e = 1 - Math.pow(1 - k, 3); n.textContent = Math.round(de + (ate - de) * e).toLocaleString('en-US'); if (k < 1) requestAnimationFrame(f); };
              requestAnimationFrame(f);
            }, { threshold: .5 });
            io.observe(n);
          })();
        </script>
