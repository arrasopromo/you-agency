     const p = new URLSearchParams();
     ['utm_source', 'utm_medium', 'utm_campaign', 'utm_term', 'utm_content', 'gclid', 'fbclid'].forEach(k => {
        if (queryParams[k]) p.set(k, queryParams[k]);
     });
     const s = p.toString();
     if (s) serverQueryString = '?' + s;
  }
