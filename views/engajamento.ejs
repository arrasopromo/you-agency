  <script>
    // TikTok/Facebook: card do serviço some quando todos os tipos dele estão ocultos (Gerenciamento de Tipo).
    (function () {
      try {
        fetch('/api/redes/catalogo', { headers: { Accept: 'application/json' } }).then(function (r) { return r.json(); }).then(function (d) {
          if (!d || !d.ok || !Array.isArray(d.servicos)) return;
          var tem = {}; d.servicos.forEach(function (s) { var k = /seguidores/.test(s.tipo) ? 'seguidores' : (/curtidas/.test(s.tipo) ? 'curtidas' : (/comentarios/.test(s.tipo) ? 'comentarios' : 'visualizacoes')); tem[s.rede + '|' + k] = true; });
          Array.prototype.forEach.call(document.querySelectorAll('a[data-plat="tiktok"], a[data-plat="facebook"]'), function (c) {
            var m = String(c.getAttribute('href') || '').match(/servicio=([a-z]+)/); var k = m ? m[1] : '';
            if (k && !tem[c.getAttribute('data-plat') + '|' + k]) { c.setAttribute('data-oculto', '1'); c.style.display = 'none'; }
          });
          try { if (window.__contaColunasCards) window.__contaColunasCards(); } catch (_) {}
          // Instagram: comentários ocultos no Gerenciamento de Tipo → some o card de comentários.
          if (d.instagramOcultos && d.instagramOcultos.comentarios) {
            Array.prototype.forEach.call(document.querySelectorAll('[data-plat="instagram"][onclick*="servicios-comentarios"]'), function (c) { c.setAttribute('data-oculto', '1'); c.style.display = 'none'; });
            try { if (window.__contaColunasCards) window.__contaColunasCards(); } catch (_) {}
          }
        }).catch(function () {});
      } catch (_) {}
    })();
    // Plataforma: Instagram / TikTok / Facebook trocam os cards do mesmo grid.
    (function () {
      // Quantos cards estão visíveis → --cols da grade (centraliza quando são menos de 4).
      function contaColunas() {
        var grid = document.getElementById('engajamentoServiceCards');
        if (!grid) return;
        var n = Array.prototype.filter.call(grid.children, function (c) { return c.style.display !== 'none' && getComputedStyle(c).display !== 'none'; }).length;
        grid.style.setProperty('--cols', String(Math.max(1, Math.min(4, n || 4))));
      }
      window.__contaColunasCards = contaColunas;
      function mostrar(plat) {
        var grid = document.getElementById('engajamentoServiceCards');
        if (!grid) return;
        grid.style.display = 'grid';
        Array.prototype.forEach.call(grid.querySelectorAll('[data-plat]'), function (c) { c.style.display = (c.getAttribute('data-plat') === plat && c.getAttribute('data-oculto') !== '1') ? '' : 'none'; });
        contaColunas();
        Array.prototype.forEach.call(document.querySelectorAll('.platform-btn'), function (b) { b.setAttribute('aria-pressed', b.classList.contains(plat) ? 'true' : 'false'); });
        var tip = document.getElementById('tutorialPlatform'); if (tip) tip.style.setProperty('display', 'none', 'important');
        setTimeout(function () { try { rolarSuave(); } catch (_) {} }, 120);
      }
      // Rolagem leve até os cards: anima devagar (ease-in-out) e para com os botões das redes no
      // topo, logo abaixo do menu fixo — sem o "puxão" do scrollIntoView nativo.
      function rolarSuave() {
        var ref = document.querySelector('#plataformaCard .platform-toggle') || document.getElementById('engajamentoServiceCards');
        if (!ref) return;
        var menu = document.querySelector('.fixed-menu');
        var folga = (menu ? menu.getBoundingClientRect().height : 60) + 56;
        var inicio = window.pageYOffset || document.documentElement.scrollTop || 0;
        var alvo = Math.max(0, ref.getBoundingClientRect().top + inicio - folga);
        var dist = alvo - inicio;
        if (Math.abs(dist) < 40) return;
        if (window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches) { window.scrollTo(0, alvo); return; }
        var dur = Math.min(1300, Math.max(850, Math.abs(dist) * 1.1));
        var t0 = null;
        var ease = function (p) { return p < 0.5 ? 4 * p * p * p : 1 - Math.pow(-2 * p + 2, 3) / 2; };
        var parar = false;
        var cancelar = function () { parar = true; };
        window.addEventListener('wheel', cancelar, { passive: true, once: true });
        window.addEventListener('touchstart', cancelar, { passive: true, once: true });
        (function passo(ts) {
          if (parar) return;
          if (t0 === null) t0 = ts;
          var p = Math.min(1, (ts - t0) / dur);
          window.scrollTo(0, inicio + dist * ease(p));
          if (p < 1) requestAnimationFrame(passo);
        })(performance.now());
      }
      document.addEventListener('click', function (e) {
        var b = e.target.closest && e.target.closest('.platform-btn');
        if (!b) return;
        e.preventDefault();
        mostrar(b.classList.contains('tiktok') ? 'tiktok' : (b.classList.contains('facebook') ? 'facebook' : 'instagram'));
      });
      try {
        var q = String(new URLSearchParams(location.search).get('plataforma') || '').toLowerCase();
        if (q === 'tiktok' || q === 'facebook') document.addEventListener('DOMContentLoaded', function () { mostrar(q); });
      } catch (_) {}
    })();
  </script>
</body>
</html>
