    <script>
    (function(){
      var $ = function(id){ return document.getElementById(id); };
      var qsUtm = function(){ try { var p = new URLSearchParams(window.location.search); var keep = new URLSearchParams(); ['utm_source','utm_medium','utm_campaign','utm_term','utm_content','fbclid','gclid','sck'].forEach(function(k){ if (p.get(k)) keep.set(k, p.get(k)); }); return keep; } catch(_) { return new URLSearchParams(); } };
      var limpa = function(v){ v = String(v || '').trim(); var m = v.match(/instagram\.com\/([A-Za-z0-9._]+)/i); if (m) v = m[1]; return v.replace(/^@+/, '').replace(/[\/?#].*$/, '').replace(/\s+/g, ''); };
      var fmt = function(n){ return Number(n).toLocaleString('en-US'); };
      var reduz = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      // única animação: os seguidores da prévia sobem uma vez
      var conta = function(el, de, ate, ms){ var cid = (el.__cid = (el.__cid || 0) + 1); if (reduz) { el.textContent = fmt(ate); return; } var t0 = null; var passo = function(t){ if (el.__cid !== cid) return; if (!t0) t0 = t; var k = Math.min(1, (t - t0) / ms); var e = 1 - Math.pow(1 - k, 3); el.textContent = fmt(Math.round(de + (ate - de) * e)); if (k < 1) requestAnimationFrame(passo); }; requestAnimationFrame(passo); };
      // seguidores da prévia sobem aos poucos (+N com balão), como um pedido entrando
      // botão "Quiero crecer mi perfil": desce até a escolha de plataforma / pacotes
      (function(){ var bp = document.getElementById('yaBtnPacotes'); if (!bp) return; bp.addEventListener('click', function(e){ var alvo = document.getElementById('plataformaCard'); if (!alvo) return; e.preventDefault(); alvo.scrollIntoView({ behavior: reduz ? 'auto' : 'smooth', block: 'start' }); try { navigator.sendBeacon('/api/funil/evento', new Blob([JSON.stringify({ evento: 'hero_pacotes' })], { type: 'application/json' })); } catch(_) {} }); })();
      var igReal = false, igSeg = 1180, igTm = null;
      var igPasso = function(){
        if (igReal || document.hidden) return;
        var inc = [100, 150, 200, 250][Math.floor(Math.random() * 4)];
        if (igSeg + inc > 9800) { igSeg = 1180; $('yaIgSeg').textContent = fmt(igSeg); return; }
        var pop = $('yaIgPop'), box = $('yaIgSegBox');
        pop.textContent = '+' + inc + ' seguidores'; pop.classList.add('on'); box.classList.add('sobe');
        conta($('yaIgSeg'), igSeg, igSeg + inc, 1100); igSeg += inc;
        setTimeout(function(){ pop.classList.remove('on'); box.classList.remove('sobe'); }, 1900);
      };
      var igParar = function(){ igReal = true; if (igTm) clearInterval(igTm); var pop = $('yaIgPop'); if (pop) pop.classList.remove('on'); };
      if (!reduz) { setTimeout(igPasso, 900); igTm = setInterval(igPasso, 3200); }
      // o @ digitado aparece na prévia
      var inp = $('yaArrobaInput');
      if (inp) inp.addEventListener('input', function(){
        var u = limpa(inp.value);
        $('yaIgUser').textContent = u || 'tu.usuario'; $('yaIgUserTop').textContent = u || 'tu.usuario';
        $('yaIgIni').textContent = (u.replace(/[^A-Za-z0-9]/g, '').slice(0, 2) || 'TU').toUpperCase();
      });
      var form = $('yaArrobaForm'), btn = $('yaArrobaBtn'), msg = $('yaArrobaMsg');
      (function(){
        var sim = $('yaConfSim'), nao = $('yaConfNao'), conf = $('yaConf');
        var ev = function(nomeEv){ try { navigator.sendBeacon('/api/funil/evento', new Blob([JSON.stringify({ evento: nomeEv, servico: 'hero' })], { type: 'application/json' })); } catch(_) {} };
        if (sim) sim.addEventListener('click', function(){ ev('hero_confirmou'); });
        if (nao) nao.addEventListener('click', function(){ ev('hero_trocou'); conf.hidden = true; form.hidden = false; inp.value = ''; msg.textContent = ''; try { sessionStorage.removeItem('ya_ig_validado'); } catch(_) {} inp.focus(); });
      })();
      if (form) form.addEventListener('submit', async function(e){
        e.preventDefault(); msg.textContent = '';
        var u = limpa(inp.value);
        if (!/^[A-Za-z0-9._]{2,30}$/.test(u)) { msg.textContent = 'Escribe tu usuario de Instagram, por ejemplo tu.usuario'; inp.focus(); return; }
        btn.disabled = true; btn.textContent = 'Buscando...';
        var funil = function(ev, extra){ try { fetch('/api/funil/evento', { method: 'POST', headers: { 'Content-Type': 'application/json' }, keepalive: true, body: JSON.stringify(Object.assign({ evento: ev, servico: 'hero' }, extra || {})) }).catch(function(){}); } catch(_) {} };
        funil('hero_tentou');
        try {
          var utms = {}; qsUtm().forEach(function(v, k){ utms[k.replace(/^utm_/, '')] = v; });
          var r = await fetch('/api/check-instagram-profile', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ username: u, utms: utms }) });
          var d = await r.json();
          if (d && d.success) {
            var pr = d.profile || {}; var nome = pr.username || u;
            funil('hero_validado', { tipo: pr.isPrivate ? 'privado' : 'publico' });
            igParar();
            $('yaIgUser').textContent = nome; $('yaIgUserTop').textContent = nome;
            $('yaIgNome').textContent = pr.fullName || 'Perfil encontrado';
            if (pr.postsCount != null) $('yaIgPosts').textContent = fmt(pr.postsCount);
            if (pr.followingCount != null) $('yaIgSegue').textContent = fmt(pr.followingCount);
            var seg = Number(pr.followersCount); $('yaIgSeg').__cid = ($('yaIgSeg').__cid || 0) + 1; if (isFinite(seg)) $('yaIgSeg').textContent = fmt(seg);
            var cat = document.querySelector('.yh-ig-id small'); if (cat) cat.textContent = '';
            $('yaIgBio').textContent = pr.isPrivate ? 'Tu perfil está privado. Ponlo público para recibir tu pedido.' : 'Encontramos tu perfil. Ahora elige tu paquete.';
            var foto = String(pr.profilePicUrl || pr.driveImageUrl || '').trim();
            if (foto) { if (/^https?:\/\//i.test(foto) && /instagram|cdninstagram|fbcdn|scontent/i.test(foto)) foto = '/image-proxy?url=' + encodeURIComponent(foto); var im = new Image(); im.onload = function(){ $('yaIgFoto').style.backgroundImage = 'url("' + foto + '")'; $('yaIgIni').textContent = ''; }; im.src = foto; }
            $('yaIgNota').textContent = 'Tu perfil';
            try { sessionStorage.setItem('ya_ig_validado', nome); } catch(_) {}
            var q = qsUtm(); q.set('ig', nome);
            var link = '/servicios-instagram?' + q.toString();
            // "¿Es tu cuenta?": o cliente confirma o perfil antes de ir aos pacotes (como no Explota)
            $('yaConfUser').textContent = '@' + nome;
            $('yaConfNome').textContent = pr.fullName || '';
            $('yaConfSeg').textContent = isFinite(seg) ? fmt(seg) + ' seguidores' : '';
            $('yaConfIni').textContent = String(nome).slice(0, 2).toUpperCase();
            $('yaConfFoto').style.backgroundImage = '';
            if (foto) { var im2 = new Image(); im2.onload = function(){ $('yaConfFoto').style.backgroundImage = 'url("' + foto + '")'; $('yaConfIni').textContent = ''; }; im2.src = foto; }
            $('yaConfAviso').hidden = !pr.isPrivate;
            $('yaConfSim').href = link;
            form.hidden = true; $('yaConf').hidden = false;
            btn.disabled = false; btn.textContent = 'Empezar';
            try { $('yaConfSim').focus({ preventScroll: true }); } catch(_) {}
            return;
          }
          funil('hero_erro', { erro: String((d && (d.error || d.message)) || 'nao_encontrado').slice(0, 120) });
          msg.textContent = (d && (d.error || d.message)) ? String(d.error || d.message) : 'No encontramos ese usuario. Revisa cómo está escrito.';
        } catch (_) { funil('hero_erro', { erro: 'falha_rede' }); msg.textContent = 'No pudimos revisar tu perfil ahora. Inténtalo de nuevo.'; }
        btn.disabled = false; btn.textContent = 'Empezar';
      });
      // Prova social: compras reais recentes, uma por vez.
      (async function(){
        var box = $('yaProva'); if (!box) return;
        var itens = []; try { var r = await fetch('/api/ventas-recientes', { cache: 'no-store' }); var d = await r.json(); itens = (d && d.items) || []; } catch(_) {}
        if (!itens.length) return;
        var ha = function(t){ var m = Math.max(1, Math.round((Date.now() - t) / 60000)); if (m < 60) return 'hace ' + m + ' min'; var h = Math.round(m / 60); return h < 24 ? 'hace ' + h + ' h' : 'hace ' + Math.round(h / 24) + ' d'; };
        var i = 0, mostra = function(){
          var it = itens[i % itens.length]; i++;
          $('yaProvaU').textContent = it.quem;
          $('yaProvaQ').textContent = it.oque;
          $('yaProvaT').textContent = ha(it.t);
          box.hidden = false; box.classList.remove('sai');
          setTimeout(function(){ box.classList.add('sai'); }, 4500);
        };
        setTimeout(function(){ mostra(); var n = 1; var tm = setInterval(function(){ if (n++ >= 5) { clearInterval(tm); return; } mostra(); }, 12000); }, 3000);
      })();
    })();
    </script>
