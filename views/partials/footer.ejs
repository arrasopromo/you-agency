<style>
  .ya-footer { width: 100%; margin-top: 3rem; border-top: 1px solid var(--border-color, #374151); color: var(--text-secondary, #A1A1AA); font-family: var(--font-family, 'Inter', sans-serif); text-align: left; box-sizing: border-box; }
  .ya-footer__grid { max-width: 1100px; margin: 0 auto; padding: 2.25rem 20px 1.75rem; display: grid; grid-template-columns: minmax(0, 1.6fr) minmax(0, 1fr) minmax(0, 1fr); gap: 2rem; }
  .ya-footer__logo { display: inline-flex; align-items: center; gap: .55rem; text-decoration: none; color: var(--text-primary, #fff); font-weight: 800; font-size: 1.15rem; }
  .ya-footer__mark { width: 34px; height: 34px; border-radius: 9px; object-fit: contain; }
  .ya-footer__mark--light { display: none; }
  body.theme-light .ya-footer__mark--dark { display: none; }
  body.theme-light .ya-footer__mark--light { display: inline-block; }
  .ya-footer__desc { margin: .85rem 0 0; max-width: 34ch; line-height: 1.55; font-size: .92rem; }
  .ya-footer__col { display: flex; flex-direction: column; gap: .6rem; min-width: 0; }
  .ya-footer__title { margin: 0 0 .2rem; font-size: .95rem; font-weight: 700; color: var(--text-primary, #fff); letter-spacing: 0; }
  .ya-footer__col a { color: var(--text-secondary, #A1A1AA); text-decoration: none; font-size: .92rem; width: fit-content; }
  .ya-footer__col a:hover { color: var(--text-primary, #fff); }
  .ya-footer__col a.ya-footer__wa { display: inline-flex; align-items: center; gap: .4rem; color: #22c55e; font-weight: 600; }
  body.theme-light .ya-footer__col a.ya-footer__wa { color: #15803d; }
  .ya-footer__col a.ya-footer__wa:hover { color: #4ade80; }
  .ya-footer__bottom { border-top: 1px solid var(--border-color, #374151); max-width: 1100px; margin: 0 auto; padding: 1rem 20px 1.4rem; font-size: .82rem; box-sizing: border-box; }
  @media (max-width: 720px) {
    .ya-footer__grid { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 1.6rem 1.25rem; padding-top: 1.75rem; }
    .ya-footer__brand { grid-column: 1 / -1; }
  }
</style>
