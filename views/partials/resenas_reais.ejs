<%
  // Avaliações reais aprovadas no painel (/painel/avaliacoes), para as páginas de serviço.
  // A seção fica escondida até a API devolver pelo menos uma avaliação aprovada.
  // A home (/interaccion, engajamento.ejs) tem a própria versão dentro de #depoimentosCard.
%>
<section id="resenasServico" class="rs-sec" hidden aria-label="Reseñas de clientes">
  <div class="why-us-pill">¿Qué dice la gente?</div>
  <h2 class="why-us-title">Mira las reseñas de quienes <span class="why-us-gradient-text">nos compraron</span></h2>
  <div class="rs-lista"></div>
</section>
<style>
  .rs-sec{display:flex;flex-direction:column;align-items:center;text-align:center;width:100%;max-width:1100px;margin:2.5rem auto 1rem;padding:0 16px;box-sizing:border-box}
  .rs-sec[hidden]{display:none}
  .rs-sec .why-us-title{margin-bottom:1.25rem}
  .rs-lista{width:100%;display:flex;flex-wrap:wrap;justify-content:center;gap:16px;padding:4px 0 14px;box-sizing:border-box}
  .rs-card{flex:1 1 300px;max-width:350px;box-sizing:border-box;text-align:left;padding:18px 20px;border-radius:16px;background:var(--bg-secondary,#1A1A2E);border:1px solid rgba(139,92,246,.22);display:flex;flex-direction:column;gap:10px}
  .rs-card .est{color:#f5b301;font-size:1.05rem;letter-spacing:2px}
  .rs-card .txt{margin:0;color:var(--text-primary);font-size:.98rem;line-height:1.5}
  .rs-card .quem{margin-top:auto;font-size:.82rem;color:var(--text-secondary);line-height:1.45}
  .rs-card .quem b{color:var(--text-primary);font-weight:700}
  body.theme-light .rs-card{background:#ffffff;border-color:#e6e8ee;box-shadow:0 10px 26px -20px rgba(15,23,42,.35)}
  @media (max-width:560px){.rs-card{max-width:100%}}
</style>
<script src="/js/resenas-carrusel.js?v=3"></script>
<script>
  (function(){
    var sec = document.getElementById('resenasServico'); if (!sec) return;
    var box = sec.querySelector('.rs-lista');
    var esc = function(t){ return String(t == null ? '' : t).replace(/[&<>"']/g, function(c){ return { '&':'&amp;', '<':'&lt;', '>':'&gt;', '"':'&quot;', "'":'&#39;' }[c]; }); };
    fetch('/api/resenas/publicas', { headers: { Accept: 'application/json' } }).then(function(r){ return r.json(); }).then(function(d){
      var it = (d && d.itens) || [];
      if (!it.length) return;
      box.innerHTML = it.map(function(x){
        var est = ''; for (var i = 1; i <= 5; i++) est += i <= x.estrelas ? '★' : '☆';
        var quem = '<b>' + esc(x.nomeExibicao || 'Cliente') + '</b>' + (x.usuarioMascarado ? ' · ' + esc(x.usuarioMascarado) : '') + ' · compró ' + esc(x.produto);
        return '<article class="rs-card"><div class="est" aria-label="' + x.estrelas + ' de 5 estrellas">' + est + '</div>' + (x.texto ? '<p class="txt">“' + esc(x.texto) + '”</p>' : '') + '<div class="quem">' + quem + '</div></article>';
      }).join('');
      sec.hidden = false;
      if (window.yaResenasCarrusel) window.yaResenasCarrusel(box); // carrossel para os lados (24/11)
    }).catch(function(){});
  })();
</script>
