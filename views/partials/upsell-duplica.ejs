<%
  // Upsell "duplica tu pedido" (mesmo card da Oppus), cobrando pela Xpag (SPEI com CLABE aberta, ou OXXO) en MXN.
  // Aparece só no pedido pago, recém-comprado (não vindo da área do cliente) e que não é upsell.
  var _dupSt = String(order.status || (order.xpag && order.xpag.status) || '').toLowerCase();
  var _dupPago = (_dupSt === 'pago' || _dupSt === 'paid' || _dupSt === 'completed');
  var _dupFromCliente = (typeof fromCliente !== 'undefined') ? !!fromCliente : false;
  var _dupId = String(order.identifier || order.correlationID || '').trim();
  var _dupShow = false;
  if (!_dupFromCliente && _dupPago && _dupId && !(order.upsell && order.upsell.isUpsell)) {
    var _dupT = String(order.tipo || order.tipoServico || '').toLowerCase();
    var _dupMap = order.additionalInfoMapPaid || order.additionalInfoMap || {};
    var _dupArr = Array.isArray(order.additionalInfoPaid) ? order.additionalInfoPaid : (Array.isArray(order.additionalInfo) ? order.additionalInfo : []);
    var _dupCat = String(_dupMap['categoria_servico'] || (_dupArr.find(function(i){ return i && i.key === 'categoria_servico'; }) || {}).value || '').toLowerCase();
    // TikTok/Facebook não têm upsell (o "duplica" é calculado com as tabelas do Instagram).
    _dupShow = !!_dupT && !/^(tiktok|facebook)_/.test(_dupT) && _dupCat !== 'tiktok' && _dupCat !== 'facebook' && (_dupCat === 'seguidores' || _dupCat === 'curtidas' || _dupCat === 'visualizacoes' || /seguidores|curtida|visual|^mistos$|^brasileiros$|^organicos$/.test(_dupT));
  }
  // Método do upsell: SPEI ou OXXO, já marcado com o que o cliente usou no pedido principal.
  var _dupMetodo = (String((order.xpag && order.xpag.method) || '').toUpperCase() === 'OXXO') ? 'OXXO' : 'SPEI';
%>
<% if (_dupShow) { %>
<style>
  @keyframes dupPulse{0%,100%{opacity:1}50%{opacity:.35}}
  @keyframes dupFadeIn{from{opacity:0;transform:translateY(-8px)}to{opacity:1;transform:translateY(0)}}
  @keyframes dupSpin{to{transform:rotate(360deg)}}
  #dupCard{display:none;margin:0 auto 1.5rem;max-width:560px}
  #dupCard.active{display:block}
  #dupBox{width:100%;background:#fff;border-radius:16px;border:1px solid #e6e8ec;box-shadow:0 8px 26px rgba(17,24,39,.08);animation:dupFadeIn .35s ease;overflow:hidden;text-align:left}
  #dupBox, #dupBox *{font-family:'Poppins',-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,sans-serif;box-sizing:border-box}
  #dupInner{padding:8px 18px 18px}
  .dup-pill{display:inline-flex;align-items:center;gap:5px;padding:4px 10px;border-radius:999px;background:#fef3f2;border:1px solid #fbd5cd;color:#c2410c;font-size:10.5px;font-weight:800;letter-spacing:.03em;text-transform:uppercase}
  .dup-timer{display:inline-flex;align-items:center;gap:5px;padding:4px 10px;border-radius:999px;background:#f1f5f9;color:#475569;font-size:12px;font-weight:800;font-variant-numeric:tabular-nums}
  .dup-close{margin-left:auto;background:none;border:none;color:#94a3b8;font-size:21px;line-height:1;cursor:pointer;padding:0 2px}
  .dup-head{font-size:18px;font-weight:800;color:#0f172a;line-height:1.3;margin:14px 0 7px;letter-spacing:-.01em;text-wrap:balance}
  .dup-accent{color:#6b46c1}
  .dup-sub{color:#64748b;font-size:.85rem;line-height:1.5;margin-bottom:17px}
  .dup-benefits{display:flex;flex-direction:column;gap:12px;margin-bottom:18px}
  .dup-benefit{display:flex;align-items:center;gap:11px;font-size:.88rem;color:#334155}
  .dup-bico{flex:none;width:28px;height:28px;border-radius:50%;background:#efeafd;color:#6b46c1;display:flex;align-items:center;justify-content:center}
  .dup-price-row{display:flex;align-items:baseline;flex-wrap:wrap;gap:6px 10px;margin-bottom:14px}
  .dup-old{font-size:15px;color:#94a3b8;text-decoration:line-through}
  .dup-price{font-size:27px;font-weight:800;color:#0f172a;line-height:1;letter-spacing:-.02em;font-variant-numeric:tabular-nums}
  .dup-badge{padding:3px 8px;border-radius:6px;background:#efeafd;color:#5b3aa8;font-size:11px;font-weight:800}
  .dup-met{display:flex;align-items:center;gap:8px;margin-bottom:14px;font-size:.82rem;color:#64748b;font-weight:600}
  .dup-met button{flex:1;padding:8px 10px;border-radius:10px;border:1.5px solid #e2e8f0;background:#fff;color:#334155;font-size:.85rem;font-weight:700;cursor:pointer}
  .dup-met button[aria-pressed="true"]{border-color:#6b46c1;background:#f5f2fe;color:#5b3aa8}
  .dup-cta{width:100%;padding:11px 16px;border-radius:11px;border:none;background:#6b46c1;color:#fff;cursor:pointer;box-shadow:0 5px 14px rgba(107,70,193,.24);display:flex;flex-direction:column;align-items:center;gap:1px;transition:background .15s}
  .dup-cta:hover{background:#5b3aa8}
  .dup-decline{display:block;width:100%;margin-top:10px;padding:6px;border:none;background:none;color:#94a3b8;font-size:.82rem;font-weight:600;cursor:pointer;text-align:center}
  .dup-decline:hover{color:#64748b}
  .dup-pay-title{font-size:16px;font-weight:900;color:#111;text-align:center;margin-bottom:3px}
  .dup-pay-sub{color:#6b7280;font-size:.82rem;text-align:center;margin-bottom:14px}
  .dup-rows{display:flex;flex-direction:column;gap:8px;margin-bottom:12px}
  .dup-row{display:flex;justify-content:space-between;gap:12px;font-size:.88rem;color:#334155}
  .dup-row b{color:#0f172a;text-align:right}
  .dup-code{position:relative;margin-bottom:12px}
  .dup-code label{display:block;font-size:.75rem;font-weight:700;color:#64748b;margin-bottom:5px;text-transform:uppercase;letter-spacing:.03em}
  .dup-code input{width:100%;padding:11px 84px 11px 12px;border-radius:10px;border:1px solid #e5e7eb;background:#f9fafb;color:#111;font-family:ui-monospace,Menlo,Consolas,monospace !important;font-size:15px;font-weight:700;letter-spacing:.04em}
  .dup-code button{position:absolute;right:6px;bottom:6px;padding:6px 12px;border-radius:7px;border:none;background:#6b46c1;color:#fff;font-size:12px;font-weight:700;cursor:pointer}
  .dup-link{display:block;text-align:center;font-size:.82rem;color:#6b46c1;font-weight:600;text-decoration:none;margin-bottom:12px}
  .dup-status{display:flex;align-items:center;justify-content:center;gap:7px;color:#6b7280;font-size:.85rem;font-weight:600}
</style>
<div id="dupCard" aria-live="polite">
  <div id="dupBox">
    <div style="display:flex;align-items:center;gap:8px;padding:14px 16px 0">
      <span class="dup-pill">
        <svg width="10" height="10" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2c1 4-2 5-2 8a2 2 0 104 0c0-1 0-2 1-3 1 2 2 3 2 5a5 5 0 11-10 0c0-4 3-6 5-10z"/></svg>
        Última oferta
      </span>
      <div id="dupTimerBox" class="dup-timer">
        <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg>
        <span id="dupTimerText">--:--</span>
      </div>
      <button type="button" class="dup-close" aria-label="Cerrar" onclick="document.getElementById('dupCard').classList.remove('active')">&times;</button>
    </div>
    <div id="dupInner">
      <div id="dupLoading" style="text-align:center;color:#6b7280;font-size:.88rem;padding:20px 0">
        <span style="display:inline-block;width:16px;height:16px;border:2px solid #e5e7eb;border-top-color:#6b46c1;border-radius:50%;animation:dupSpin .7s linear infinite;vertical-align:middle;margin-right:7px"></span>
        Verificando oferta…
      </div>
      <div id="dupOffer" style="display:none">
        <div class="dup-head">Espera — <span class="dup-accent">duplica tu pedido</span> con <span id="dupPct" class="dup-accent">30%</span> de descuento</div>
        <div id="dupSub" class="dup-sub"></div>
        <div class="dup-benefits">
          <div class="dup-benefit">
            <span class="dup-bico"><svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 00-3-3.87M16 3.13a4 4 0 010 7.75"/></svg></span>
            <span id="dupBenefitQty">el doble de lo que pediste</span>
          </div>
          <div class="dup-benefit">
            <span class="dup-bico"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg></span>
            <span>Se entrega justo después del paquete principal</span>
          </div>
        </div>
        <div class="dup-price-row">
          <span id="dupOld" class="dup-old"></span>
          <span id="dupPrice" class="dup-price">$ —</span>
          <span id="dupBadge" class="dup-badge"></span>
        </div>
        <div class="dup-met" role="group" aria-label="Método de pago">
          <button type="button" data-dup-met="SPEI" aria-pressed="<%= _dupMetodo === 'SPEI' ? 'true' : 'false' %>">SPEI</button>
          <button type="button" data-dup-met="OXXO" aria-pressed="<%= _dupMetodo === 'OXXO' ? 'true' : 'false' %>">OXXO</button>
        </div>
        <button id="dupAccept" type="button" class="dup-cta">
          <span id="dupAcceptLabel" style="font-size:.9rem;font-weight:800">Quiero aprovechar</span>
          <span id="dupBtnTimer" style="font-size:10.5px;font-weight:600;opacity:.9;font-variant-numeric:tabular-nums">⏳ cargando…</span>
        </button>
        <button type="button" class="dup-decline" onclick="document.getElementById('dupCard').classList.remove('active')">No, gracias</button>
      </div>
      <div id="dupPay" style="display:none">
        <div id="dupPayTitle" class="dup-pay-title">Transfiere por SPEI</div>
        <div id="dupPaySub" class="dup-pay-sub">Se confirma automáticamente</div>
        <div id="dupSpeiRows" class="dup-rows"></div>
        <div class="dup-code">
          <label id="dupCodeLabel" for="dupCode">CLABE</label>
          <input id="dupCode" type="text" readonly>
          <button id="dupCopy" type="button">Copiar</button>
        </div>
        <a id="dupPayLink" class="dup-link" href="#" target="_blank" rel="noopener">Ver instrucciones completas ›</a>
        <div class="dup-status">
          <span style="width:8px;height:8px;border-radius:50%;background:#f59e0b;animation:dupPulse 1.2s infinite"></span>
          Esperando el pago…
        </div>
      </div>
      <div id="dupDone" style="display:none;text-align:center;padding:10px 0">
        <div style="width:50px;height:50px;border-radius:50%;background:#22c55e;display:flex;align-items:center;justify-content:center;margin:0 auto 10px">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6L9 17l-5-5"/></svg>
        </div>
        <div style="font-size:17px;font-weight:900;color:#111;margin-bottom:4px">¡Oferta confirmada!</div>
        <div style="color:#6b7280;font-size:.85rem;line-height:1.5">Pago confirmado. Tu pedido se entregará muy pronto.</div>
      </div>
    </div>
  </div>
</div>
<script>
(function(){
  var id = <%- JSON.stringify(_dupId) %>;
  if (!id) return;
  var $ = function(x){ return document.getElementById(x); };
  var card = $('dupCard'), loading = $('dupLoading'), offerDiv = $('dupOffer'), payDiv = $('dupPay'), doneDiv = $('dupDone');
  var timerEl = $('dupTimerText'), btnTimer = $('dupBtnTimer'), accept = $('dupAccept'), lbl = $('dupAcceptLabel');
  var metodo = <%- JSON.stringify(_dupMetodo) %>;
  var pending = null, timerIv = null, pollIv = null, ctaTxt = 'DUPLICAR MI PEDIDO';
  function abrir(){ card.classList.add('active'); }
  function so(el){ [loading, offerDiv, payDiv, doneDiv].forEach(function(e){ if (e) e.style.display = 'none'; }); if (el) el.style.display = ''; var tb = $('dupTimerBox'); if (tb) tb.style.display = (el === offerDiv || el === loading) ? '' : 'none'; }
  function mxn(c){ return '$ ' + (Number(c || 0) / 100).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' MXN'; }
  function qf(n){ return Number(n || 0).toLocaleString('en-US'); }
  function esc(s){ return String(s == null ? '' : s).replace(/[&<>"]/g, function(c){ return ({ '&':'&amp;', '<':'&lt;', '>':'&gt;', '"':'&quot;' })[c]; }); }
  function expirou(){
    if (timerEl) timerEl.textContent = '00:00';
    accept.disabled = true; accept.style.background = '#9ca3af'; accept.style.boxShadow = 'none'; accept.style.cursor = 'not-allowed';
    lbl.textContent = 'Oferta expirada'; if (btnTimer) btnTimer.textContent = 'Esta oferta ya no está disponible';
  }
  function timer(exAt){
    clearInterval(timerIv); var exp = new Date(exAt).getTime();
    function tick(){
      var rem = Math.max(0, exp - Date.now()), m = Math.floor(rem / 60000), s = Math.floor((rem % 60000) / 1000);
      var ts = String(m).padStart(2, '0') + ':' + String(s).padStart(2, '0');
      if (timerEl) timerEl.textContent = ts; if (btnTimer) btnTimer.textContent = 'Expira en ' + ts;
      if (rem <= 0) { clearInterval(timerIv); expirou(); }
    }
    tick(); timerIv = setInterval(tick, 1000);
  }
  function poll(uid){
    clearInterval(pollIv);
    pollIv = setInterval(function(){
      fetch('/api/upsell/status?identifier=' + encodeURIComponent(uid)).then(function(r){ return r.json(); }).then(function(d){
        if (d && d.paid) { clearInterval(pollIv); clearInterval(timerIv); so(doneDiv); abrir(); }
      }).catch(function(){});
    }, 5000);
  }
  function mostrarPago(p){
    if (!p) return;
    var oxxo = String(p.metodo || '').toUpperCase() === 'OXXO';
    $('dupPayTitle').textContent = oxxo ? 'Paga en cualquier OXXO' : 'Transfiere por SPEI';
    $('dupPaySub').textContent = oxxo ? 'Muestra la referencia en caja y paga en efectivo. Se confirma automáticamente.' : 'Desde la app de tu banco. Se confirma automáticamente.';
    var rows = oxxo ? [['Monto', mxn(p.valueCents)]] : [['Banco', p.banco], ['Beneficiario', p.beneficiario], ['Monto', mxn(p.valueCents)]];
    $('dupSpeiRows').innerHTML = rows.filter(function(r){ return r[1]; }).map(function(r){ return '<div class="dup-row"><span>' + esc(r[0]) + '</span><b>' + esc(r[1]) + '</b></div>'; }).join('');
    $('dupCodeLabel').textContent = oxxo ? 'Referencia OXXO' : 'CLABE';
    $('dupCode').value = (oxxo ? p.referencia : p.clabe) || '';
    var link = $('dupPayLink'); link.href = p.payUrl || '#'; link.textContent = oxxo ? 'Ver código de barras e instrucciones ›' : 'Ver instrucciones completas ›';
    clearInterval(timerIv); so(payDiv); abrir();
    if (p.identifier) poll(p.identifier);
    // TrackCombo: liga a venda do upsell à visita pelo número do pedido (= external_id da cobrança Xpag).
    try {
      if (p.externalId) {
        var evTc = { event: 'add_payment_info', transaction_id: p.externalId, value: Number(p.valueCents || 0) / 100, currency: 'MXN' };
        var nTc = 0; (function t(){ try { if (window.tcData && typeof window.tcData.executeEvent === 'function') { window.tcData.executeEvent(evTc); return; } } catch (_) {} if (++nTc < 40) setTimeout(t, 250); })();
      }
    } catch (_) {}
  }
  // Seletor SPEI / OXXO
  Array.prototype.forEach.call(document.querySelectorAll('[data-dup-met]'), function(b){
    b.addEventListener('click', function(){
      metodo = b.getAttribute('data-dup-met');
      Array.prototype.forEach.call(document.querySelectorAll('[data-dup-met]'), function(o){ o.setAttribute('aria-pressed', o === b ? 'true' : 'false'); });
    });
  });
  $('dupCopy').addEventListener('click', function(){
    var el = $('dupCode'), b = this, ok = function(){ var t = b.textContent; b.textContent = '¡Copiado!'; setTimeout(function(){ b.textContent = t; }, 1300); };
    try { navigator.clipboard.writeText(el.value).then(ok).catch(function(){ el.select(); }); } catch (_) { el.select(); }
  });
  // Oferta
  fetch('/api/upsell/offer?identifier=' + encodeURIComponent(id)).then(function(r){ return r.json(); }).then(function(d){
    if (!d || !d.ok) return;
    if (d.alreadyAccepted) { if (d.paid) { so(doneDiv); abrir(); } return; }
    var o = d.offer; if (!o) return;
    pending = d.pending || null;
    var svc = o.tipoLabel || 'seguidores', pct = o.discountPct || 30;
    var cheio = Number(o.fullCents || 0); // preço cheio do site (riscado)
    $('dupPct').textContent = pct + '%';
    $('dupBenefitQty').textContent = '+ ' + qf(o.offerQty) + ' ' + svc + ' — el doble de lo que pediste';
    $('dupSub').textContent = 'Agrega +' + qf(o.offerQty) + ' ' + svc + ' a tu pedido — la misma cantidad que acabas de comprar, con ' + pct + '% de descuento. Precio solo en esta pantalla.';
    $('dupPrice').textContent = mxn(o.offerCents);
    if (cheio > o.offerCents) $('dupOld').textContent = mxn(cheio);
    $('dupBadge').textContent = '-' + pct + '%';
    ctaTxt = 'DUPLICAR MI PEDIDO — ' + mxn(o.offerCents);
    lbl.textContent = ctaTxt;
    so(offerDiv); abrir();
    if (o.expired) expirou(); else timer(o.expiredAt);
  }).catch(function(){});
  // Aceitar → gera a cobrança Xpag (ou reabre a pendente)
  accept.addEventListener('click', function(){
    if (accept.disabled) return;
    if (pending) { mostrarPago(pending); return; }
    accept.disabled = true; lbl.textContent = 'Generando tu pago…';
    fetch('/api/upsell/charge', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ parentIdentifier: id, metodo: metodo }) })
      .then(function(r){ return r.json(); })
      .then(function(d){
        if (!d || !d.ok) { accept.disabled = false; lbl.textContent = ctaTxt; alert(d && d.error === 'offer_expired' ? 'Esta oferta ya expiró.' : 'No pudimos generar el pago. Inténtalo de nuevo.'); return; }
        if (d.alreadyAccepted && d.paid) { so(doneDiv); return; }
        pending = d; mostrarPago(d);
      })
      .catch(function(){ accept.disabled = false; lbl.textContent = ctaTxt; alert('No pudimos generar el pago. Inténtalo de nuevo.'); });
  });
})();
</script>
<% } %>
