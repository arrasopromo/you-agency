<script>
  // Rastreio site → WhatsApp: no clique em qualquer link do WhatsApp, a mensagem ganha um código "(#XXXXX)"
  // e o site guarda esse código com a origem da visita (clique do anúncio, UTMs). O bot lê o código e a
  // venda fechada no WhatsApp é creditada ao anúncio certo (metaCapi.js). O bot tira o código do texto.
  (function () {
    if (window.__yaWaRef) return; window.__yaWaRef = true;
    var ALF = 'ABCDEFGHJKLMNPQRSTUVWXYZ23456789';
    function novoCodigo() { var s = ''; for (var i = 0; i < 5; i++) s += ALF.charAt(Math.floor(Math.random() * ALF.length)); return s; }
    document.addEventListener('click', function (e) {
      try {
        var a = e.target && e.target.closest ? e.target.closest('a[href*="wa.me/"], a[href*="api.whatsapp.com/"]') : null;
        if (!a) return;
        var u = new URL(a.href);
        var txt = u.searchParams.get('text') || '';
        if (/\(#[A-Z0-9]{5}\)/.test(txt)) txt = txt.replace(/\s*\(#[A-Z0-9]{5}\)/, '');
        var code = novoCodigo();
        var resto = new URLSearchParams(u.search); resto.delete('text'); resto = resto.toString();
        // encodeURIComponent (espaço = %20): com "+" o WhatsApp pode mostrar o sinal na mensagem.
        a.href = u.origin + u.pathname + '?' + (resto ? resto + '&' : '') + 'text=' + encodeURIComponent((txt ? txt + ' ' : '') + '(#' + code + ')');
        var body = JSON.stringify({ code: code, pagina: location.pathname });
