                    <input type="text" id="contactNameInput" class="select-input" placeholder="Tu nombre" autocomplete="name" maxlength="80" style="width:100%; border-radius: 8px; margin-bottom: 1rem;" />
                    <div id="emailErrorMsg" class="rd-erro">Ingresa un correo electrónico válido</div>
                    <label for="contactEmailInput" style="display:block; margin-bottom:0.5rem; color:var(--text-primary); font-weight:500;">Correo electrónico <span style="color:#ef4444">*</span></label>
                    <input type="email" id="contactEmailInput" class="select-input" placeholder="Tu mejor correo electrónico" autocomplete="email" style="width:100%; border-radius: 8px;" />
