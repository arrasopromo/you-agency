                    <input type="tel" id="contactPhoneInput" class="select-input" placeholder="55 1234 5678" inputmode="tel" autocomplete="tel-national" maxlength="24" style="width:100%; border-radius: 8px;" />
                  </div>
                  <a href="javascript:void(0)" id="btnActionProceed" class="continue-button contact-continue-btn" style="width: 100%; padding: 1rem; font-size: 1.1rem; border-radius: 8px; display: flex; justify-content: center; align-items: center; background: var(--instagram-gradient); text-decoration: none; color: white; cursor: pointer;">
                    <span class="button-text">Continuar</span>
