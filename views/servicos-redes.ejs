                      <svg class="button-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" style="margin-left: 0.4rem;"><path d="M5 12H19M19 12L12 5M19 12L12 19" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                    </button>
                    <div id="tutorial3Usuario" class="tutorial-pop tutorial-pop-input" style="display:block;">
                      <div class="tutorial-pop-step">3/5</div>
                      <div class="tutorial-pop-text"><%= _rede === 'facebook' ? 'Ingresa tu perfil o página de Facebook' : 'Ingresa tu usuario de TikTok' %></div>
                    </div>
                  </div>
                  <style>
                    @media (max-width: 640px) {
                      #grupoUsername { flex-direction: column; }
