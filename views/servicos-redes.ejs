                    <input type="checkbox" id="promoComments" data-promo="comments" />
                    <div class="promo-content">
                      <div class="promo-highlight" id="commentsHighlight">+ 1 COMENTARIOS</div>
                      <div class="promo-title" style="display:flex; align-items:center; gap:0.5rem;">
                        <span>Comentarios en promoción</span>
                        <button id="commentsExampleBtn" class="continue-button" type="button" style="padding:0.15rem 0.5rem; font-size:12px; line-height:1;">Ejemplos de comentarios</button>
                      </div>
                      <div class="promo-desc">1 comentario = $ 20 c/u.</div>
                      <div class="promo-prices" data-promo="comments">
                        <span class="old-price">-</span>
                        <span class="discount-badge">41% OFF</span>
                        <span class="new-price">-</span>
                      </div>
                      <div class="likes-control" aria-label="Cantidad de comentarios">
                        <button type="button" id="commentsDec" class="likes-arrow" aria-label="Disminuir">−</button>
                        <span id="commentsQty" class="likes-qty">1</span>
                        <button type="button" id="commentsInc" class="likes-arrow" aria-label="Aumentar">+</button>
                      </div>
                    </div>
                  </label>
                  <div id="bumpLinkArea" style="display:none; margin-top:0.5rem;">
                    <div id="bumpLinkError" class="rd-erro"></div>
                    <label for="bumpLink" style="display:block; margin-bottom:0.4rem; font-weight:600; color:var(--text-primary);"><span id="bumpLinkLabel">Enlace del video para las ofertas</span> <span style="color:#ef4444">*</span></label>
                    <button type="button" id="bumpVideoBtn" class="rd-video-btn" style="display:none; margin-bottom:0.5rem;">
                      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="7" height="7" rx="1.5"/><rect x="14" y="3" width="7" height="7" rx="1.5"/><rect x="3" y="14" width="7" height="7" rx="1.5"/><rect x="14" y="14" width="7" height="7" rx="1.5"/></svg>
                      <span>Elegir de mis videos</span>
                    </button>
                    <input type="url" id="bumpLink" class="select-input" inputmode="url" autocomplete="off" maxlength="300" style="width:100%; border-radius:8px;" />
                    <div id="bumpLinkHint" style="margin-top:0.35rem; color: var(--text-secondary); font-size:0.82rem;"></div>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <div class="service-card" id="resumo" style="margin-top: 1rem; max-width: 960px; margin-left: auto; margin-right: auto;">
            <div class="card-content">
              <h3 class="card-title">Resumen del pedido</h3>
              <div class="resumo-row"><span>Servicio</span><span id="resTipo">-</span></div>
              <div class="resumo-row"><span>Cantidad</span><span id="resQtd">-</span></div>
              <div class="resumo-row"><span>Precio del paquete</span><span id="resPreco">-</span></div>
              <div id="resPromosContainer" style="display:none;"><div id="resPromos"></div></div>
              <div class="resumo-row" id="resCupomRow" style="display:none;"><span id="resCupomLabel">Cupón</span><span id="resCupom" style="color:#22c55e;">-</span></div>
              <div class="resumo-total"><span>Total</span><span id="resTotalFinal" style="color: #22c55e;">-</span></div>
              <div id="grupoPedido" style="margin-top: 1.5rem;">
                <div id="stripeBadgeCard" style="display:flex; align-items:center; justify-content:center; gap:10px; margin-top:8px; margin-bottom:10px; color:#6b7280; font-size:0.85rem; text-align:center;">
                  <span>Pago seguro por transferencia SPEI</span>
                </div>
                <%- include('partials/metodos_pago') %>
                <div id="payErrorMsg" class="rd-erro"></div>
                <button id="payWithCardBtn" type="button" class="continue-button" style="margin-top:0.5rem; display:flex; align-items:center; justify-content:center; position:relative; padding-right:52px;">
                  <span class="button-text">Pagar con SPEI</span>
                  <svg class="button-icon" style="position:absolute; right:16px;" width="20" height="20" viewBox="0 0 24 24" fill="none"><path d="M5 12H19M19 12L12 5M19 12L12 19" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                </button>
              </div>
            </div>
          </div>
        </div>
      </section>
    </main>

    <div id="commentsExampleModal" class="modal-overlay" style="display:none; align-items:center; justify-content:center; z-index:9999;">
      <div class="modal-dialog" style="max-width:400px; width:90%; border-radius: 16px; padding: 1.5rem; position:relative; display:flex; flex-direction:column;">
        <div class="modal-header" style="border:none; padding-bottom:0;">
          <h3 class="modal-title" style="margin:0 auto;">Ejemplos de comentarios</h3>
          <button id="commentsExampleCloseBtn" class="modal-close" type="button" aria-label="Cerrar" style="position:absolute; right:1rem; top:1rem;">×</button>
        </div>
        <div class="modal-body" style="text-align:center;">
          <div style="position:relative; aspect-ratio: 9 / 16; height: clamp(320px, 60vh, 560px); max-width: 100%; margin: 0.75rem auto 0; border-radius:12px; overflow:hidden; box-shadow: var(--shadow); background: #000;">
            <video id="commentsVideoPlayer" controls muted playsinline preload="none" style="position:absolute; inset:0; width:100%; height:100%; object-fit: cover;">
              <source src="/images/comentarios-leve.mp4" type="video/mp4" />
            </video>
          </div>
          <p style="margin-top:0.75rem; color: var(--text-secondary);">Perfiles de alta calidad, comentarios positivos y caída mínima.</p>
        </div>
        <div class="modal-footer">
          <button id="commentsExampleCloseBtn2" class="continue-button" type="button">Cerrar</button>
        </div>
      </div>
    </div>
  </div>
    <!-- Grade de vídeos do TikTok (mesmo modal "Selecciona la publicación" do Instagram) -->
    <div id="rdVideoModal" class="modal-overlay" style="display:none;">
      <div class="modal-dialog">
        <div class="modal-header">
          <h3 id="rdVideoModalTitle" class="modal-title">Selecciona el video</h3>
          <button id="rdVideoModalClose" class="modal-close" type="button" aria-label="Cerrar">×</button>
        </div>
        <div class="modal-body">
          <div id="rdVideoGrid" class="post-grid"></div>
        </div>
        <div class="modal-footer">
          <button id="rdVideoModalClose2" class="continue-button" type="button">Cerrar</button>
        </div>
      </div>
    </div>
  <style>
    #rdVideoModal.modal-overlay { position: fixed; inset: 0; display: none; align-items: center; justify-content: center; background: rgba(0,0,0,0.92); z-index: 1000; }
    #rdVideoModal .modal-dialog { width: 98vw; max-width: 1100px; max-height: calc(100vh - 2rem); overflow: auto; }
    #rdVideoGrid.post-grid { display: grid; gap: 12px; grid-template-columns: repeat(2, 1fr); }
    @media (min-width: 768px) { #rdVideoGrid.post-grid { grid-template-columns: repeat(3, 1fr); } }
    @media (min-width: 1024px) { #rdVideoGrid.post-grid { grid-template-columns: repeat(5, 1fr); } }
    #rdVideoGrid .rd-vid { display: flex; flex-direction: column; gap: 6px; padding: 6px; border-radius: 10px; border: 1px solid var(--border-color); background: var(--bg-secondary); cursor: pointer; min-width: 0; }
    #rdVideoGrid .rd-vid.selected-mark { outline: 2px solid #7c3aed; }
    #rdVideoGrid .rd-vid-media { position: relative; aspect-ratio: 9 / 16; border-radius: 8px; overflow: hidden; background: #000; }
    #rdVideoGrid .rd-vid-media img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
    #rdVideoGrid .rd-vid-views { position: absolute; left: 6px; bottom: 6px; padding: 2px 6px; border-radius: 6px; background: rgba(0,0,0,0.6); color: #fff; font-size: 12px; font-weight: 600; }
    #rdVideoGrid .rd-vid-desc { font-size: 12px; color: var(--text-secondary); text-align: center; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; min-height: 1.2em; }
    #rdVideoGrid .continue-button { justify-content: center; width: 100%; padding: 0.55rem 0.5rem; font-size: 0.9rem; }
    #rdVideoGrid .rd-vid-msg { grid-column: 1 / -1; text-align: center; color: var(--text-secondary); padding: 1rem; }
    @media (max-width: 640px) { #rdVideoModal.modal-overlay { align-items: flex-start; } #rdVideoModal .modal-dialog { width: 100%; max-width: 95vw; margin-top: 1rem; max-height: 85vh; } #rdVideoGrid .rd-vid-media { max-height: 240px; } }
    .rd-video-btn { display: inline-flex; align-items: center; justify-content: center; gap: 0.5rem; width: 100%; margin-bottom: 0.9rem; padding: 0.7rem 1rem; border-radius: 10px; border: 1.5px solid #7c3aed; background: rgba(124,58,237,0.08); color: #7c3aed; font-weight: 700; font-size: 0.95rem; cursor: pointer; }
    .rd-video-btn:hover { background: rgba(124,58,237,0.15); }
    .rd-video-sel { margin-bottom: 0.75rem; }
    .rd-video-sel .rd-vs-box { display: flex; align-items: center; gap: 0.75rem; padding: 0.6rem; border-radius: 10px; border: 1.5px solid #22c55e; background: rgba(34,197,94,0.07); }
    .rd-video-sel img { width: 48px; height: 64px; object-fit: cover; border-radius: 6px; background: #000; flex: none; }
    .rd-video-sel .rd-vs-txt { min-width: 0; font-size: 0.85rem; color: var(--text-secondary); }
    .rd-video-sel .rd-vs-txt strong { display: block; color: var(--text-primary); font-size: 0.92rem; }
    .rd-video-sel .rd-vs-txt span { display: block; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .contact-continue-btn { background: linear-gradient(135deg, #10b981 0%, #059669 100%); box-shadow: 0 4px 6px -1px rgba(16, 185, 129, 0.3), 0 2px 4px -1px rgba(16, 185, 129, 0.15); border: none; transition: transform 0.2s, box-shadow 0.2s; }
    .contact-continue-btn:hover { transform: translateY(-2px); box-shadow: 0 10px 15px -3px rgba(16, 185, 129, 0.4), 0 4px 6px -2px rgba(16, 185, 129, 0.2); }
    .contact-continue-btn:active { transform: translateY(0); }
  </style>
  <%- include('partials/footer') %>
  <script src="/js/main.js"></script>
  <script src="/js/servicos-redes.js?v=20261116c"></script>
<script src="/js/ventas-recientes.js?v=20261122c" defer></script>
</body>
</html>
