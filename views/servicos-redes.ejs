<% const _rede = (typeof rede !== 'undefined' && rede === 'facebook') ? 'facebook' : 'tiktok'; const _nome = _rede === 'facebook' ? 'Facebook' : 'TikTok';
   const _sv = String((typeof queryParams !== 'undefined' && queryParams && queryParams.servicio) || '').toLowerCase();
   const _foco = /coment|comment/.test(_sv) ? 'comentarios' : (/curtid|gusta|like/.test(_sv) ? 'curtidas' : (/visualiz|view/.test(_sv) ? 'visualizacoes' : 'seguidores'));
   const _focoNome = _foco === 'curtidas' ? 'me gusta' : (_foco === 'visualizacoes' ? 'vistas' : (_foco === 'comentarios' ? 'comentarios' : 'seguidores')); %>
<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="utf-8" />
  <title>Comprar <%= _focoNome %> para <%= _nome %> | You Agency</title>
  <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no" />
  <meta name="description" content="Comprar <%= _focoNome %> para <%= _nome %>. Pago por SPEI, sin contraseña." />
  <script>
    (function () {
      try {
        var p = new URLSearchParams(location.search), utms = {};
        ['utm_source', 'utm_medium', 'utm_campaign', 'utm_term', 'utm_content', 'gclid', 'fbclid'].forEach(function (k) { var v = p.get(k); if (v) utms[k] = v; });
        if (Object.keys(utms).length) sessionStorage.setItem('ya_utms', JSON.stringify(utms));
      } catch (_) {}
    })();
  </script>
  <link href="/css/style.css?v=20261118b" rel="stylesheet" />
  <link href="/css/badges.css" rel="stylesheet" />
  <link href="/css/perfil.css" rel="stylesheet" />
  <link href="/css/why-us.css?v=20261111" rel="stylesheet" />
  <link rel="icon" type="image/png" href="/images/y%20branco.png" />
  <!-- TRACK COMBO -->
  <script>
    (function() {
      var script = document.createElement("script");
      script.type = "text/javascript"; script.async = true;
      script.src = "https://track.youagency.site/tag/TC-OISDR3RC.js";
      var firstScript = document.getElementsByTagName("script")[0];
      firstScript.parentNode.insertBefore(script, firstScript);
    })();
  </script>
  <!-- End TRACK COMBO -->
<style id="ya-so-email">#nameErrorMsg,label[for="contactNameInput"],#contactNameInput,#phoneErrorMsg,label[for="contactPhoneInput"],#contactPhoneInput,.phone-field,.mx-phone-wrap{display:none !important}</style>
</head>
<body class="theme-light has-fixed-menu page-instagram-services page-redes">
  <%- include('partials/menu', { logoLink: '/interaccion' }) %>
  <div class="container checkout-page">
    <style>
      /* Mesmo layout dos cards de tipo da página do Instagram (servicos-instagram.ejs). */
      #tipoCards { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1rem; width: 100%; max-width: 980px; margin: 0 auto; justify-content: center; }
      #tipoCards .service-card { width: 100%; min-width: 0; min-height: 150px; padding: 14px 12px; display: flex; flex-direction: column; align-items: center; justify-content: center; background: var(--bg-secondary); border: 1px solid var(--border-color); border-radius: 12px; box-sizing: border-box; margin: 0; cursor: pointer; }
      #tipoCards .service-card.active { background: var(--primary-purple, #8B5CF6); border: 1px solid var(--primary-purple, #8B5CF6); color: white; box-shadow: 0 4px 10px rgba(139, 92, 246, 0.4); transform: translateY(-2px); }
      #tipoCards .service-card.active .card-title { color: white; }
      @media (min-width: 1024px) {
        #tipoCards { max-width: 1120px; gap: 1.25rem; }
        #tipoCards .service-card { min-height: 170px; padding: 18px 16px; }
      }
      @media (max-width: 639px) {
        #tipoCards { grid-template-columns: repeat(2, 1fr) !important; gap: 4px !important; width: calc(100% + 44px) !important; margin-left: -22px !important; padding: 0 4px !important; }
        #tipoCards .service-card { min-height: 125px !important; padding: 8px 4px !important; }
        #tipoCards .card-title { font-size: 0.88rem !important; line-height: 1.3 !important; text-align: center !important; font-weight: 600 !important; }
      }
      .rd-plat { display: flex; align-items: center; justify-content: center; gap: 8px; margin: 0 auto 1rem; font-weight: 700; color: var(--text-primary); }
      .rd-plat .rd-logo { width: 28px; height: 28px; border-radius: 8px; display: grid; place-items: center; color: #fff; }
      .rd-plat .rd-logo.tiktok { background: #000; }
      .rd-plat .rd-logo.facebook { background: #1877F2; }
      .rd-plat .rd-logo svg { width: 17px; height: 17px; }
      .rd-plat a { font-weight: 500; font-size: 0.85rem; color: var(--primary-purple, #7c3aed); text-decoration: none; margin-left: 6px; }
      #resumo .rd-res-row { display: flex; justify-content: space-between; gap: 12px; padding: 6px 0; border-bottom: 1px solid var(--border-color, #eef0f3); }
      #resumo .rd-res-row span:last-child { text-align: right; min-width: 0; overflow-wrap: anywhere; }
      .rd-erro { color: #ef4444; font-size: 0.85rem; display: none; margin-bottom: 0.3rem; }
      #resumo .resumo-row, #resumo .resumo-total { display: flex; justify-content: space-between; align-items: center; gap: 12px; padding: 0.35rem 0; }
      #resumo .resumo-row span:last-child { text-align: right; min-width: 0; overflow-wrap: anywhere; }
      #resumo .resumo-total { font-weight: 700; font-size: 1.05rem; border-top: 1px solid var(--border-color); margin-top: 0.4rem; padding-top: 0.6rem; }
      /* Celular: um tipo só (ex.: Me gusta mixtos) fica centralizado, com a largura de um card da grade de 2 */
      @media (max-width: 640px) {
        #step1Container #tipoCards[data-n="1"] { grid-template-columns: minmax(0, calc(50% - 6px)) !important; justify-content: center !important; }
      }
    </style>
    <main class="main-content" id="rdMain" data-rede="<%= _rede %>">
      <div class="stepper-container">
        <div class="step active" id="step1" onclick="window.goToStep && window.goToStep(1)" style="cursor: pointer;">
          <div class="step-circle">1</div>
          <div class="step-label">Servicio</div>
        </div>
        <div class="step-line" id="line1"></div>
        <div class="step" id="step2" onclick="window.goToStep && window.goToStep(2)" style="cursor: pointer;">
          <div class="step-circle">2</div>
          <div class="step-label">Detalles</div>
        </div>
        <div class="step-line" id="line2"></div>
        <div class="step" id="step3" onclick="window.goToStep && window.goToStep(3)" style="cursor: pointer;">
          <div class="step-circle">3</div>
          <div class="step-label">Pago</div>
        </div>
      </div>

      <% var _svq = String((typeof queryParams !== 'undefined' && queryParams && queryParams.servicio) || '').toLowerCase(); var _rsSv = /coment|comment/.test(_svq) ? 'comentarios' : (/curtid|gusta|like/.test(_svq) ? 'curtidas' : (/visualiz|view|vista/.test(_svq) ? 'visualizacoes' : 'seguidores')); %>
      <%- include('partials/rede_selecionada', { rede: _rede, servico: _rsSv }) %>

      <section class="section-block">
        <div id="step1Container" class="cards-grid checkout-grid">
          <div id="tipoCards"></div>
          <div class="service-card" id="tipoDescCard" style="display:none; margin-top: 1rem; margin-bottom: 1rem;">
            <div class="card-content">
              <h3 class="card-title" id="tipoDescTitle">Descripción del servicio</h3>
              <div class="card-desc" id="tipoDescContent"></div>
            </div>
          </div>
          <div id="planCards" class="plan-cards" style="display:none;"></div>
        </div>
      </section>

      <section class="section-block">
        <div id="perfilCard" style="display:none;">
          <div class="service-card">
            <div class="card-content">
              <div style="text-align: center; margin-bottom: 1.5rem; position: relative; display: flex; flex-direction: column; align-items: center; gap: 0.5rem;">
