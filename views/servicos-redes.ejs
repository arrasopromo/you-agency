                    }
                  </style>
                  <div id="perfilHints" style="margin-top:0.4rem; color: var(--text-secondary); font-size: 0.85rem;">
                    <%= _rede === 'facebook' ? 'Pega el enlace de tu perfil o página (ej. facebook.com/tupagina) o solo el nombre de usuario.' : 'Puedes escribirlo con o sin @ (ej. @usuario o usuario), o pegar el enlace de tu perfil.' %>
                  </div>
                  <div id="statusCheckoutMessage" class="status-message" style="display:none; margin-top:0.5rem;"></div>
                  <div id="loadingCheckoutSpinner" class="loading-spinner" style="display:none; margin-top:0.5rem;">
                    <div class="spinner"></div>
                    <p>Verificando perfil...</p>
                  </div>

                  <!-- Preview do Perfil -->
                  <div id="profilePreview" style="display:none; margin-top:1rem; padding: 1rem; background: var(--bg-secondary); border-radius: 12px; border: 1px solid var(--border-color);">
                    <div style="display:flex; align-items:center; gap:1rem;">
                      <img id="checkoutProfileImage" alt="Foto" referrerpolicy="no-referrer" style="width:64px; height:64px; border-radius:50%; object-fit:cover; background:#fff; flex:none;" />
                      <div style="min-width:0;">
                        <div style="font-weight:700; font-size:1.1rem; color: var(--text-primary); overflow-wrap:anywhere;"><span id="checkoutProfileUsername"></span></div>
                        <div id="checkoutProfileName" style="font-size:0.85rem; color: var(--text-secondary);"></div>
                        <div id="checkoutProfileStats" style="display:flex; flex-wrap:wrap; gap:0.8rem; font-size:0.9rem; color: var(--text-secondary); margin-top:0.2rem;"></div>
                      </div>
                    </div>
                  </div>
                </div>

                <!-- 2. Campos de Contato (aparecem depois de buscar o perfil, como no Instagram) -->
                <div id="contactFieldsArea" style="display:none; margin-top: 2rem; border-top: 1px solid #e2e8f0; padding-top: 1.5rem;">
                  <div id="postLinkArea" style="display:none; margin-bottom: 1.25rem;">
                    <div id="linkErrorMsg" class="rd-erro"></div>
                    <div id="rdVideoSel" class="rd-video-sel" style="display:none;"></div>
                    <button type="button" id="rdVideoBtn" class="rd-video-btn" style="display:none;">
                      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="7" height="7" rx="1.5"/><rect x="14" y="3" width="7" height="7" rx="1.5"/><rect x="3" y="14" width="7" height="7" rx="1.5"/><rect x="14" y="14" width="7" height="7" rx="1.5"/></svg>
                      <span>Elegir de mis videos</span>
                    </button>
                    <label for="rdLink" style="display:block; margin-bottom:0.5rem; color:var(--text-primary); font-weight:500;"><span id="rdLinkLabel">Enlace</span> <span style="color:#ef4444">*</span></label>
                    <input type="url" id="rdLink" class="select-input" inputmode="url" autocomplete="off" maxlength="300" style="width:100%; border-radius: 8px;" />
                    <div id="rdLinkHint" style="margin-top:0.4rem; color: var(--text-secondary); font-size: 0.85rem;"></div>
                  </div>
                  <div style="margin-bottom: 1rem;">
                    <div style="background-color: #eff6ff; padding: 0.75rem; border-radius: 8px; border: 1px solid #dbeafe; margin-bottom: 0.8rem;">
                      <span style="color: #1e40af; font-weight: 700; font-size: 0.95rem; display: block; margin-bottom: 0.3rem;">¿Para qué es tu correo?</span>
                      <p style="font-size: 0.85rem; color: #1e3a8a; margin: 0; line-height: 1.4;">Te enviamos ahí la confirmación y el estado de tu pedido. Es el único dato que te pedimos.</p>
                    </div>
