<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="utf-8" />
  <title>Servicios para Instagram | You Agency</title>
  <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no" />
  <link href="/css/style.css?v=20261118b" rel="stylesheet" />
  <link href="/css/perfil.css" rel="stylesheet" />
  <link rel="icon" type="image/png" href="/images/y%20branco.png" />
</head>
<body class="theme-light has-fixed-menu">
  <%- include('partials/menu') %>
  <div class="container checkout-page">

    <header class="header">
      <h1 class="title">Elige el servicio de seguidores</h1>
      <p class="subtitle" style="margin-top:0.25rem;">Elige entre Mixtos y Reales para continuar.</p>
    </header>
    <div id="clientPage" class="client-page" aria-label="Consulta de pedidos" style="display:none;">
      <div class="client-page-inner">
        <h2 class="client-title">Consulta de pedidos</h2>
        <p class="client-desc">Ingresa tu correo electrónico o número de pedido para encontrar tus pedidos.</p>
        <div class="client-form">
          <input id="clientLookupInputPage" type="email" class="select-input" placeholder="" autocomplete="email" />
          <div class="client-actions">
            <button id="clientPageConsultBtn" class="continue-button"><span class="button-text">Buscar</span></button>
            <button id="clientPageBackBtn" class="continue-button" style="background: transparent; border-color: var(--border-color); color: var(--text-primary);"><span class="button-text">Volver</span></button>
          </div>
        </div>
        <div id="clientPageOrders" class="client-orders"></div>
      </div>
    </div>
    <main class="main-content">
      <section class="section-block">
        <div class="cards-grid">
          <a href="/perfil?servico=seguidores_mistos" class="service-card">
            <div class="card-content">
              <h3 class="card-title">Seguidores mixtos</h3>
              <div class="card-desc">Entrega rápida y estable, perfecta para hacer crecer tu base.</div>
            </div>
          </a>
          <a href="/perfil?servico=seguidores_organicos" class="service-card">
            <div class="card-content">
              <h3 class="card-title">Seguidores reales (latinos)</h3>
              <div class="card-desc">Perfiles latinos reales y activos, con mayor credibilidad. 100% seguro y confidencial, sin contraseña.</div>
            </div>
          </a>
        </div>
      </section>
    </main>
<%- include('partials/footer') %>
  </div>
  <script src="/js/main.js"></script>
  <script src="/js/checkout.js?v=<%= Date.now() %>"></script>
</body>
</html>
